generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors the Supabase auth.users row for the same id. We keep our own
// User table so we can attach app data via foreign keys without reaching
// into the auth schema directly.
model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())

  // Onboarding profile — collected once after registration so the app and
  // the AI companion have basic context about who they're talking to.
  firstName             String?
  birthDate             DateTime? @db.Date
  goals                 String[] @default([])
  concerns              String[] @default([])
  stressAreas           String[] @default([])
  usageFrequency        String?
  cycleTrackingEnabled  Boolean   @default(false)
  lastPeriodStartDate   DateTime? @db.Date
  cycleLengthDays       Int?
  healthDataConsentAt   DateTime?
  onboardingCompletedAt DateTime?

  moodEntries    MoodEntry[]
  journalEntries JournalEntry[]
  activityLogs   ActivityLog[]
  conversations  ChatConversation[]
  ttsRequests    TtsRequest[]
  importantDates ImportantDate[]

  @@map("users")
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  note      String?
  tags      String[] @default([])
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("mood_entries")
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("journal_entries")
}

model Activity {
  id       String        @id @default(cuid())
  name     String        @unique
  category String
  logs     ActivityLog[]

  @@map("activities")
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id])
  durationMin Int?
  occurredAt  DateTime @default(now())

  @@index([userId, occurredAt])
  @@map("activity_logs")
}

model ChatConversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]

  // Rolling memory: a compact summary of messages older than the active
  // context window, plus how many (oldest-first) messages it already
  // covers. Lets the AI companion recall relevant history from a long
  // conversation without resending the entire transcript on every turn.
  summary                String?
  summarizedMessageCount Int      @default(0)

  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  // Data URL (data:image/jpeg;base64,...) of an image attached to a user
  // message. Kept inline rather than in object storage to avoid needing a
  // separate storage bucket for an MVP-scale feature; capped client- and
  // server-side to keep row size and Anthropic vision costs bounded.
  imageDataUrl   String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// A user-entered "special day" (birthday of someone else, work milestone,
// anniversary, or a fully custom occasion) that the chat companion can
// proactively bring up as it approaches. Distinct from User.birthDate,
// which is the user's own birthday collected at onboarding.
model ImportantDate {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  category        String
  emoji           String   @default("✨")
  date            DateTime @db.Date
  recurringYearly Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("important_dates")
}

// One row per text-to-speech call via ElevenLabs, purely so we can enforce a
// per-user daily character budget and keep the (paid, per-character) voice
// API cost predictable.
model TtsRequest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterCount Int
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("tts_requests")
}
