# Local dev default matches docker-compose.yml
DATABASE_URL="postgresql://app:app@localhost:5432/mentalhealth?schema=public"
REDIS_URL="redis://localhost:6379"

# From your Supabase project settings (Project Settings -> API)
# Tokens are verified against this project's public JWKS endpoint
# (${SUPABASE_URL}/auth/v1/.well-known/jwks.json) - no shared secret needed.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# From https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
